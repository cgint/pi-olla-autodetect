  "description": "Pi extension that auto-discovers models from an Olla gateway endpoint and registers them as a provider.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgint/pi-olla-autodetect.git"
  },
  "author": "cgint",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "olla",
    "llm-gateway",
    "model-discovery"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.74.0",
    "@sinclair/typebox": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "precommit": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
